@startuml
title SmartRecipeHub - Architecture Technique

skinparam rectangle {
  BackgroundColor #f5f5f5
  BorderColor #333
}

actor "Utilisateur\n(Navigateur Web)" as User

cloud "Internet" {
  node "Cloudflare Tunnel\n(cloudflared)" as Tunnel
}

node "Serveur Docker" {

  node "Reverse Proxy\nCaddy" as Proxy

  node "Frontend\nReact + Vite" as Frontend

  node "Backend\nFastAPI (Python)" as Backend

  database "Base de données\nMySQL" as DB

  node "Adminer\n(Gestion DB)" as Adminer
}

User --> Tunnel : Accède au site
Tunnel --> Proxy : Transmet les requêtes

Proxy --> Frontend : Pages web
Proxy --> Backend : API REST (/api)

Frontend --> Backend : Requêtes (recettes, login, favoris)
Backend --> DB : Stockage & lecture des données

Adminer --> DB : Gestion manuelle des données

@enduml
